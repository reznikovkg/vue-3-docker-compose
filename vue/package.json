{
  "name": "vue-fiit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^24.13.1"
  },
  "scripts": {
    "dev": "vite --port 8080",
    "devhost": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "cd .. && husky vue/.husky",
    "precommit:check": "lint-staged",
    "lint": "eslint . --max-warnings 10",
    "lint:fix": "eslint . --fix --max-warnings 10",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.92.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0"
  }
}
